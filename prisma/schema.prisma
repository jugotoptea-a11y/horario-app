generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id              String     @id // documento
  nombre_completo String
  nombre_norm     String
  promo           String?
  correo          String?
  contacto        String?
  municipio       String?
  programa        String?
  actualizado_en  String?
  schedules       Schedule[]

  @@index([nombre_norm])
}

model Schedule {
  id              Int      @id @default(autoincrement())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  promocion       String?
  periodo         String?
  dia             String
  
  hora_inicio     String   // e.g. "06:30"
  hora_fin        String   // e.g. "08:30"
  hora_inicio_min Int      // e.g. 390 (para facilitar filtros de cruce numéricos)
  hora_fin_min    Int      // e.g. 510
  
  prog            String?
  codigo_clase    String?
  materia         String
  docente         String?

  @@index([studentId])
  @@index([dia, hora_inicio_min, hora_fin_min])
}
